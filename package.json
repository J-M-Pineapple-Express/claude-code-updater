{
  "name": "claude-code-updater",
  "version": "1.0.0",
  "description": "Desktop app that shows a plain-English summary of what's new in Claude Code, then updates it. Windows + macOS.",
  "main": "electron-main.js",
  "author": "AfterRealm",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/md.test.js && node test/core.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --x64 --arm64"
  },
  "build": {
    "appId": "com.afterrealm.claudecodeupdater",
    "productName": "Claude Code Updater",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "core.js",
      "public/**/*",
      "skill/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "artifactName": "ClaudeCodeUpdater-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Code Updater"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "ClaudeCodeUpdater-${version}-${arch}.${ext}",
      "identity": null
    },
    "dmg": {
      "title": "Claude Code Updater ${version}"
    }
  },
  "devDependencies": {
    "electron": "^42.11.8",
    "electron-builder": "^26.15.3"
  }
}
